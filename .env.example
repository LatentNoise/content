# Content — local docker-compose configuration.
# Copy to `.env` and adjust. Every var falls back to the compose default if
# unset. `.env` itself is git-ignored (secrets); this example is tracked so the
# available knobs are documented and never lost.

# --- Which download UIs to run ---------------------------------------------
# The engine (:8010) and the operations console (:8503) always start. This
# line picks the download UI(s) — edit it, nothing else to learn:
#   COMPOSE_PROFILES=hometube,studio   → HomeTube (:8501) + Studio (:8502)
#   COMPOSE_PROFILES=hometube          → HomeTube only
#   COMPOSE_PROFILES=studio            → Content Studio only
COMPOSE_PROFILES=hometube,studio

# --- Image version ----------------------------------------------------------
# Which published image tag compose pulls (`docker compose pull`). `latest`
# follows releases; pin an exact one (e.g. 0.1.0) for a reproducible stack.
# Irrelevant if you build locally with `docker compose up --build`.
CONTENT_VERSION=latest

# --- Ports & general -------------------------------------------------------
# Host port for the API (8000 is often taken; the UIs reach the backend on the
# compose network regardless). UI ports: HOMETUBE_PORT (8501), STUDIO_PORT
# (8502), CONSOLE_PORT (8503).
CONTENT_PORT=8010
TZ=Europe/Paris

# Whether THIS process runs the job worker (ADR 0032). Unset means true, which
# is the single-process deployment everyone has. Set it to false on a process
# that should only answer requests, and run a second one with true beside it —
# same image, same code. Both must stay on the same machine: they share one
# SQLite file.
# CONTENT_WORKER_ENABLED=true

# Worker concurrency and per-step timeout (seconds).
CONTENT_MAX_CONCURRENT_JOBS=2
CONTENT_STEP_TIMEOUT_SECONDS=3600

# How many members of one playlist/collection run at once, WITHIN ONE JOB. A
# politeness bound toward the provider, not a throughput dial; 1 = strictly one
# after another. Mind the multiplication: with MAX_CONCURRENT_JOBS=2 above, two
# playlists running together make up to 4 simultaneous downloads from one host.
CONTENT_COLLECTION_MEMBER_CONCURRENCY=2

# SSRF guard: true allows URLs pointing at private/loopback IPs (local testing).
CONTENT_ALLOW_PRIVATE_NETWORKS=false

# --- Summaries (optional LLM runners) --------------------------------------
# Ollama daemon as seen from the container; empty model = first installed.
# Summaries, translations and derived chapters need a language model.
# The default points at an Ollama running on THIS host — the common case when
# you already have one. Two other paths:
#   - your own elsewhere:  CONTENT_OLLAMA_URL=http://nas.local:11434
#   - none at all:         docker compose --profile llm up -d
#                          CONTENT_OLLAMA_URL=http://ollama:11434
# Leave it empty to run without summaries; they are then reported as
# unavailable up front rather than failing mid-job.
CONTENT_OLLAMA_URL=http://host.docker.internal:11434
CONTENT_OLLAMA_MODEL=
# Context window ceiling asked of Ollama. 32768 covers roughly 2 h 20 of
# speech in one summary; past its window Ollama keeps half of it, so a
# slightly-too-long transcript loses more than half. Raise it (and give
# Ollama the RAM) for longer recordings; 0 = let the daemon decide.
CONTENT_OLLAMA_MAX_CONTEXT=32768
# Only used by the bundled container (--profile llm): the model it pulls on
# first start. ~2.5 GB for a 4B quantised model.
OLLAMA_MODEL=qwen3:4b
# Cloud summarizers (secrets — leave empty to disable).
# These enable the cloud LLM runners for summary, translation and derived
# chapters — Anthropic (Claude) and OpenAI, already supported, off until a
# key is set. They are `location: cloud`, so a request carrying
# constraints.privacy.allow_cloud_providers: false will not use them.
CONTENT_ANTHROPIC_API_KEY=
CONTENT_OPENAI_API_KEY=

# --- Licence / source link -------------------------------------------------
# Content is source-available under FSL-1.1-ALv2. Nothing obliges you to publish
# your changes — but if you MODIFIED it and let others use your instance, point
# this at YOUR repository rather than upstream, which would tell your users
# something untrue. Shown in the UIs and in GET /api/v1/system.
CONTENT_SOURCE_URL=https://github.com/LatentNoise/content

# --- Notifications (UI banner) ---------------------------------------------
# Opt-in release check: a release API answering {"tag_name": ...} (GitHub and
# Forgejo both do). Empty = no outbound call and no banner — the default,
# because your instance phoning anywhere is your decision. Only major/minor
# releases notify; patches stay silent. For this project's upstream:
#   CONTENT_RELEASE_CHECK_URL=https://api.github.com/repos/LatentNoise/content/releases/latest
#   CONTENT_RELEASE_PAGE_URL=https://github.com/LatentNoise/content/releases
# (The UIs also warn on their own — no variable, no outbound call — when the
# UI and backend images run different versions of Content.)
CONTENT_RELEASE_CHECK_URL=
CONTENT_RELEASE_PAGE_URL=
# How long a release lookup is cached, so a page render never calls out.
CONTENT_RELEASE_CHECK_TTL_HOURS=6
# Opt-in: warn in the UIs when the installed yt-dlp is this many days old
# (0 = off, the default). Off because age alone cannot tell "stale" from
# "newest available" — the image pins the latest upstream release, which may
# itself be weeks old. Enable it if you rebuild rarely and want a local nag;
# a genuinely stale yt-dlp fails analyses with "No video formats found".
CONTENT_YTDLP_MAX_AGE_DAYS=0

# --- Speech: transcription from audio (and text-to-speech) ----------------
# Activates transcript/summary FROM AUDIO for sources without subtitles.
# Run the speech service beside the engine, then point the engine at it:
#
#   docker compose --profile speech up -d
#   CONTENT_SPEECH_URL=http://speech:8000
#
# Any server speaking the OpenAI audio API works — on a private network only:
# the engine never sends audio to a public host. Empty = not used.
CONTENT_SPEECH_URL=
CONTENT_SPEECH_STT_MODEL=Systran/faster-whisper-small
CONTENT_SPEECH_API_KEY=
# The speech container itself (read by docker compose, not by the engine).
SPEECH_VERSION=0.9.0-rc.3-cpu
SPEECH_MODEL_TTL=300
SPEECH_PORT=18000
#
# ⚠️ Leave CONTENT_INSTALL_STT=false. Building faster-whisper into the engine
# image fails: it is Alpine, and ctranslate2/av publish no musl wheels.
# CONTENT_WHISPER_MODEL only matters for a non-container install with the
# [stt] extra.
CONTENT_INSTALL_STT=false
CONTENT_WHISPER_MODEL=small

# --- Language preferences (HomeTube parity) --------------------------------
# Order and pre-select audio / subtitle tracks in the UIs: VO first (if
# VO_FIRST), then the primary language, then the secondaries — keeping only what
# a source actually offers. (ex-HomeTube LANGUAGE_PRIMARY / LANGUAGES_SECONDARIES
# / VO_FIRST / LANGUAGE_PRIMARY_INCLUDE_SUBTITLES.)
#
# The last one ships as `false` while the engine's own default is `true`:
# someone fluent in the primary language rarely wants subtitles in it, but
# still wants the secondaries. It excludes ONLY the primary. A worked example
# of all four is in apps/web-hometube/README.md.
CONTENT_LANGUAGE_PRIMARY=fr
CONTENT_LANGUAGES_SECONDARIES=en,es
CONTENT_VO_FIRST=true
CONTENT_LANGUAGE_PRIMARY_INCLUDED_IN_SUBTITLES=false

# --- Uploads from a client machine -----------------------------------------
# Studio's file picker, the SDK's upload_file() and MCP's local paths all send
# bytes here first, because a laptop's path means nothing to the engine.
# This is the one endpoint that writes to the engine's disk, so it is bounded:
# per-upload ceiling, a quota for the whole store, and an expiry counted from
# an upload's LAST use (so retrying a job still finds its input).
CONTENT_MAX_UPLOAD_BYTES=2147483648
CONTENT_UPLOADS_TOTAL_BYTES=21474836480
CONTENT_UPLOAD_TTL_HOURS=24

# --- Media library (delivery folder on the host) ---------------------------
# Where downloaded media lands; its sub-folders become the destinations offered
# in the UI (ex-HomeTube VIDEOS_FOLDER_DOCKER_HOST). Point it at your library
# (a homelab/NAS path, or a local folder). Defaults to ./playground/output.
CONTENT_DELIVERY_DIR_HOST=./playground/output

# How that library is shared between users (ADR 0018, revisited 2026-09-12):
#   shared     one library for everyone, which is what self-hosting keeps:
#              /output is a library a human organises and a media server
#              reads, and adding an owner level would break paths that work
#              today.
#   per_owner  a library each, inside the owner's own directory
#              (<data>/users/<owner>/output). Two people's films must never
#              land in the same folder.
#   off        no server-side library at all; an artifact asked to be
#              delivered is refused with `delivery_not_supported`, and the
#              user downloads it instead.
# The default is derived from CONTENT_AUTH_MODE: shared when nobody signs in,
# per_owner when people do. An explicit value always wins.
# CONTENT_DELIVERY_SCOPE=shared

# How owners are filed on disk (ADR 0037). A single-user install keeps the
# historical tree, <data>/jobs/<job>; a hosted one puts everything of a person
# under <data>/users/<owner>/. Defaults from CONTENT_AUTH_MODE: flat when nobody
# signs in, per_user when people do. flat + token is refused at startup, since a
# flat tree holds exactly one owner. Existing data is filed into the configured
# layout on the next start.
# CONTENT_STORAGE_LAYOUT=flat

# --- Signing in (ADR 0033) --------------------------------------------------
# Off by default: CONTENT_AUTH_MODE=none means one implicit local user and no
# sign-in at all, which is the self-hosted contract of ADR 0024.
# CONTENT_AUTH_MODE=token turns the door on — do not set it before a mailer is
# reachable, or nobody can sign in.
# CONTENT_AUTH_MODE=none

# Where sign-in links point, and where the session cookie is valid. Set the
# cookie domain to the PARENT domain so one session works across all four
# surfaces; that is the reason they share a parent.
# CONTENT_PUBLIC_BASE_URL=https://api.latentnoise.dev
# CONTENT_SESSION_COOKIE_DOMAIN=.latentnoise.dev
# CONTENT_SESSION_COOKIE_SECURE=true      # off is for local http only
# CONTENT_SESSION_TTL_HOURS=720           # slid forward while in use
# Where a sign-in lands when the link named no destination — someone who typed
# the address by hand, or asked from the engine's own page. Without it they
# land on the engine, which serves API documentation and welcomes nobody. Must
# be one of the allowed origins below.
# CONTENT_SIGN_IN_DEFAULT_TARGET=https://studio.example.com

# Who may operate this installation (ADR 0035). An operator owns their rows
# like anyone else and may additionally read facts about the machine: disk
# usage across the installation, the shared analysis cache. Listing an address
# grants the flag at sign-in — which is how the FIRST operator exists, since
# there is nobody to promote them. Unlisting does NOT revoke it: withdrawing a
# privilege is a deliberate act on the account, not a side effect of editing
# this file. Self-hosted needs none of this: the single local user is always
# the operator.
# CONTENT_OPERATOR_EMAILS=you@example.com

# Per-owner quotas (ADR 0036). All zero = unlimited, which is what self-hosting
# keeps; an operator is never counted either.
#
# Media is counted in MINUTES OF SOURCE and not processing time: a duration is
# known at analysis, before any work happens, so a refusal comes before the
# expense — and it does not charge twenty times more for 4K than for audio at
# identical service rendered. The window rolls over 30 days rather than
# resetting on the 1st.
#
# Storage is a ceiling on what is HELD, not a running total: retention already
# expires files. Size it so a free tier can finish one real thing — ten minutes
# of 1080p video is 100-300 MB.
# How long a FINISHED job's files are kept before an unattended sweep removes
# them (ADR 0023). 0 = never, the historical behaviour and the default: an
# upgrade must not start deleting data nobody asked to delete.
#
# It EXPIRES rather than deletes: the artifact files, the sources and the job's
# tmp go; the job row, its logs, its snapshots and its artifact rows stay, so
# the history remains answerable and the API can say "expired on <date>, ask
# again" instead of "gone". Deleting a job outright is a person's own call,
# through DELETE /api/v1/jobs/{id}.
#
# ⚠️ The sweep NEVER touches the delivery library. /output is a library a human
# organises and a media server reads. Deleting a job deliberately may remove
# its delivered copies (?delivered=true), which is off by default too.
#
# This is the lever that bounds total disk use on a hosted instance — more than
# any per-person quota. With a 7-day window, occupancy follows the FLOW of work
# rather than the number of accounts.
# CONTENT_RETENTION_DAYS=0

# Per-owner quotas (ADR 0036). 0 = unlimited; an operator is never counted.
# Storage counts what the person asked for — artifacts, their delivery library
# and their uploads. Not `resources`, the raw material the engine keeps so the
# next job need not fetch it again: that is the engine's optimisation, not
# their consumption.
# CONTENT_QUOTA_MEDIA_MINUTES_PER_MONTH=30
# CONTENT_QUOTA_STORAGE_BYTES=2147483648
# CONTENT_QUOTA_CONCURRENT_JOBS=1

# What a refused person is offered. Leave every one of these unset unless you
# run an instance for other people: the engine's refusal already says what
# happened, and on a machine where the person reading is the person running it,
# "the free tier" and "our server" are nonsense. Unset = the surfaces show the
# engine's plain sentence and nothing more.
#
# The self-host command is always shown ABOVE the call to action. A wall that
# hides the free alternative is detected in three seconds by this audience; one
# that leads with it turns a refusal into a gift.
# CONTENT_QUOTA_WALL_SELF_HOST_COMMAND="docker run -p 8501:8501 ghcr.io/you/app"
# CONTENT_QUOTA_WALL_DOCS_URL=https://github.com/you/app#installation
# CONTENT_QUOTA_WALL_CTA_LABEL="Email me when it's ready"
# CONTENT_QUOTA_WALL_CTA_URL=https://example.com/waiting-list

# CONTENT_MAGIC_LINK_TTL_MINUTES=15
# How many UNOPENED sign-in links one address may hold from the last hour.
# Opened links never count: signing in again, from another browser or after
# losing a session, is never throttled — only filling a stranger's inbox is.
# CONTENT_MAGIC_LINK_MAX_PER_HOUR=15

# The surfaces this installation serves, `<kind>=<public url>` each, where a
# BROWSER reaches them (ADR 0038). Declared once, here: every UI learns the
# others from /config and offers them, and the sign-in page and email say
# "Sign in to Content Studio" rather than just "Content". Kinds: studio,
# console, hometube. Compose sets this from the host ports.
# CONTENT_SURFACES=studio=https://studio.example.com,console=https://console.example.com,hometube=https://hometube.example.com

# Where a sign-in may send the browser afterwards. Everything else is refused:
# an open redirect on a sign-in endpoint is how a phishing link borrows your
# domain. Defaults to the surfaces' origins above, which are by definition
# where a sign-in comes back to; set it only to allow something else.
# CONTENT_ALLOWED_REDIRECT_ORIGINS=https://studio.example.com,https://console.example.com

# The outbound-email service (ADR 0031). Empty = no mail is sent and the link
# is written to the log instead, which is what self-hosting does.
# CONTENT_MAILER_URL=http://mailer:8000
# CONTENT_MAILER_API_KEY=

# For a CLIENT (the CLI, the MCP server, a script): the API key this machine
# presents to a hosted engine. Mint one with POST /api/v1/auth/keys; it is
# shown once and never again. Leave it empty against a self-hosted engine,
# which asks for no credential at all.
# CONTENT_API_KEY=

# The engine's PUBLIC address, as a browser sees it. The UIs use it for artifact
# download links and, when the engine refuses a visitor, for the sign-in link
# they offer (ADR 0034). Defaults to CONTENT_API_URL, which is right when the
# UIs and the browser reach the engine at the same address.
# CONTENT_PUBLIC_API_URL=

# --- Direct API access ------------------------------------------------------
# The REST API is open (no auth in V1): curl, the SDK, scripts always reach it
# directly. CORS is the one browser-specific gate — empty (default) blocks
# cross-origin BROWSER clients only. Set explicit origins to allow a web app:
CONTENT_CORS_ORIGINS=

# --- Authenticated sources (cookies) ---------------------------------------
# Cookies unlock age-restricted/private videos and make ordinary YouTube
# downloads noticeably more reliable — near-essential for HomeTube in Docker,
# so the credential is DECLARED BY DEFAULT. Until the file exists, the UIs
# show a clear flag telling you the one step left:
#   export a Netscape cookies.txt from a signed-in browser and save it as
#   config/youtube_cookies.txt on the host — the ./config folder is mounted
#   read-only at /config inside the container, which is why the value below
#   uses the container-side path. Then `make docker-update`.
# Full walkthrough: config/README.md. Several credentials: comma-separated
# id=path pairs. Set the value to nothing to turn the feature off.
CONTENT_CREDENTIALS=youtube=/config/youtube_cookies.txt
