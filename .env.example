# Content — local docker-compose configuration.
# Copy to `.env` and adjust. Every var falls back to the compose default if
# unset. `.env` itself is git-ignored (secrets); this example is tracked so the
# available knobs are documented and never lost.

# --- Which download UIs to run ---------------------------------------------
# The engine (:8010) and the operations console (:8503) always start. This
# line picks the download UI(s) — edit it, nothing else to learn:
#   COMPOSE_PROFILES=hometube,studio   → HomeTube (:8501) + Studio (:8502)
#   COMPOSE_PROFILES=hometube          → HomeTube only
#   COMPOSE_PROFILES=studio            → Content Studio only
COMPOSE_PROFILES=hometube,studio

# --- Image version ----------------------------------------------------------
# Which published image tag compose pulls (`docker compose pull`). `latest`
# follows releases; pin an exact one (e.g. 0.1.0) for a reproducible stack.
# Irrelevant if you build locally with `docker compose up --build`.
CONTENT_VERSION=latest

# --- Ports & general -------------------------------------------------------
# Host port for the API (8000 is often taken; the UIs reach the backend on the
# compose network regardless). UI ports: HOMETUBE_PORT (8501), STUDIO_PORT
# (8502), CONSOLE_PORT (8503).
CONTENT_PORT=8010
TZ=Europe/Paris

# Worker concurrency and per-step timeout (seconds).
CONTENT_MAX_CONCURRENT_JOBS=2
CONTENT_STEP_TIMEOUT_SECONDS=3600

# How many members of one playlist/collection run at once, WITHIN ONE JOB. A
# politeness bound toward the provider, not a throughput dial; 1 = strictly one
# after another. Mind the multiplication: with MAX_CONCURRENT_JOBS=2 above, two
# playlists running together make up to 4 simultaneous downloads from one host.
CONTENT_COLLECTION_MEMBER_CONCURRENCY=2

# SSRF guard: true allows URLs pointing at private/loopback IPs (local testing).
CONTENT_ALLOW_PRIVATE_NETWORKS=false

# --- Summaries (optional LLM runners) --------------------------------------
# Ollama daemon as seen from the container; empty model = first installed.
CONTENT_OLLAMA_URL=http://host.docker.internal:11434
CONTENT_OLLAMA_MODEL=
# Context window ceiling asked of Ollama. 32768 covers roughly 2 h 20 of
# speech in one summary; past its window Ollama keeps half of it, so a
# slightly-too-long transcript loses more than half. Raise it (and give
# Ollama the RAM) for longer recordings; 0 = let the daemon decide.
CONTENT_OLLAMA_MAX_CONTEXT=32768
# Cloud summarizers (secrets — leave empty to disable).
# These enable the cloud LLM runners for summary, translation and derived
# chapters — Anthropic (Claude) and OpenAI, already supported, off until a
# key is set. They are `location: cloud`, so a request carrying
# constraints.privacy.allow_cloud_providers: false will not use them.
CONTENT_ANTHROPIC_API_KEY=
CONTENT_OPENAI_API_KEY=

# --- Licence / AGPL compliance ---------------------------------------------
# Content is AGPL-3.0-or-later. If you MODIFIED it and let others use your
# instance over a network, §13 obliges you to offer them YOUR Corresponding
# Source — point this at your own repository. Leaving it on upstream would tell
# your users something untrue. Shown in the UIs and in GET /api/v1/system.
CONTENT_SOURCE_URL=https://github.com/LatentNoise/content

# --- Notifications (UI banner) ---------------------------------------------
# Opt-in release check: a release API answering {"tag_name": ...} (GitHub and
# Forgejo both do). Empty = no outbound call and no banner — the default,
# because your instance phoning anywhere is your decision. Only major/minor
# releases notify; patches stay silent. For this project's upstream:
#   CONTENT_RELEASE_CHECK_URL=https://api.github.com/repos/LatentNoise/content/releases/latest
#   CONTENT_RELEASE_PAGE_URL=https://github.com/LatentNoise/content/releases
# (The UIs also warn on their own — no variable, no outbound call — when the
# UI and backend images run different versions of Content.)
CONTENT_RELEASE_CHECK_URL=
CONTENT_RELEASE_PAGE_URL=
# How long a release lookup is cached, so a page render never calls out.
CONTENT_RELEASE_CHECK_TTL_HOURS=6
# Opt-in: warn in the UIs when the installed yt-dlp is this many days old
# (0 = off, the default). Off because age alone cannot tell "stale" from
# "newest available" — the image pins the latest upstream release, which may
# itself be weeks old. Enable it if you rebuild rarely and want a local nag;
# a genuinely stale yt-dlp fails analyses with "No video formats found".
CONTENT_YTDLP_MAX_AGE_DAYS=0

# --- Speech-to-text (optional Whisper runner) ------------------------------
# Activates transcript/summary FROM AUDIO for sources without subtitles.
# Opt-in (heavy wheels): set true, then `docker compose build content`.
CONTENT_INSTALL_STT=false
CONTENT_WHISPER_MODEL=small

# --- Language preferences (HomeTube parity) --------------------------------
# Order and pre-select audio / subtitle tracks in the UIs: VO first (if
# VO_FIRST), then the primary language, then the secondaries — keeping only what
# a source actually offers. (ex-HomeTube LANGUAGE_PRIMARY / LANGUAGES_SECONDARIES
# / VO_FIRST / LANGUAGE_PRIMARY_INCLUDE_SUBTITLES.)
#
# The last one ships as `false` while the engine's own default is `true`:
# someone fluent in the primary language rarely wants subtitles in it, but
# still wants the secondaries. It excludes ONLY the primary. A worked example
# of all four is in apps/web-hometube/README.md.
CONTENT_LANGUAGE_PRIMARY=fr
CONTENT_LANGUAGES_SECONDARIES=en,es
CONTENT_VO_FIRST=true
CONTENT_LANGUAGE_PRIMARY_INCLUDED_IN_SUBTITLES=false

# --- Uploads from a client machine -----------------------------------------
# Studio's file picker, the SDK's upload_file() and MCP's local paths all send
# bytes here first, because a laptop's path means nothing to the engine.
# This is the one endpoint that writes to the engine's disk, so it is bounded:
# per-upload ceiling, a quota for the whole store, and an expiry counted from
# an upload's LAST use (so retrying a job still finds its input).
CONTENT_MAX_UPLOAD_BYTES=2147483648
CONTENT_UPLOADS_TOTAL_BYTES=21474836480
CONTENT_UPLOAD_TTL_HOURS=24

# --- Media library (delivery folder on the host) ---------------------------
# Where downloaded media lands; its sub-folders become the destinations offered
# in the UI (ex-HomeTube VIDEOS_FOLDER_DOCKER_HOST). Point it at your library
# (a homelab/NAS path, or a local folder). Defaults to ./playground/output.
CONTENT_DELIVERY_DIR_HOST=./playground/output

# --- Direct API access ------------------------------------------------------
# The REST API is open (no auth in V1): curl, the SDK, scripts always reach it
# directly. CORS is the one browser-specific gate — empty (default) blocks
# cross-origin BROWSER clients only. Set explicit origins to allow a web app:
CONTENT_CORS_ORIGINS=

# --- Authenticated sources (cookies) ---------------------------------------
# Cookies unlock age-restricted/private videos and make ordinary YouTube
# downloads noticeably more reliable — near-essential for HomeTube in Docker,
# so the credential is DECLARED BY DEFAULT. Until the file exists, the UIs
# show a clear flag telling you the one step left:
#   export a Netscape cookies.txt from a signed-in browser and save it as
#   config/youtube_cookies.txt on the host — the ./config folder is mounted
#   read-only at /config inside the container, which is why the value below
#   uses the container-side path. Then `make docker-update`.
# Full walkthrough: config/README.md. Several credentials: comma-separated
# id=path pairs. Set the value to nothing to turn the feature off.
CONTENT_CREDENTIALS=youtube=/config/youtube_cookies.txt
